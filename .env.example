# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored — never commit real API keys.

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Powers the "Ask SkinWise" product recommendation agent.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash if not set.
# GEMINI_MODEL=gemini-3.6-flash

# Razorpay Test Mode keys — from your Razorpay Dashboard > Settings > API Keys
# (Test Mode toggle in the top bar). These are "rzp_test_..." keys and are
# safe to use even while your account's live-mode verification is pending.
# Both stay server-only — never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
