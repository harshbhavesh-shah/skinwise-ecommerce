# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored — never commit real API keys.

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Powers the "Ask SkinWise" product recommendation agent.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash if not set.
# GEMINI_MODEL=gemini-3.6-flash

# Razorpay Test Mode keys — from your Razorpay Dashboard > Settings > API Keys
# (Test Mode toggle in the top bar). These are "rzp_test_..." keys and are
# safe to use even while your account's live-mode verification is pending.
# Both stay server-only — never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Orders database — Firebase (Firestore). Required for both local dev and
# production (no offline fallback). Get these from the Firebase Console:
# Project settings > Service accounts > Generate new private key, which
# downloads a JSON file with these three fields.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# Paste the "private_key" value from that JSON as-is, including the
# -----BEGIN PRIVATE KEY----- header and quotes around it.
# FIREBASE_PRIVATE_KEY=

# Firebase Auth — client-side config for customer accounts (safe to expose
# to the browser; access control is the server-verified session cookie, not
# secrecy of these values). From Firebase Console > Project settings >
# General > Your apps > Web app. Same project as FIREBASE_* above.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Resend — sends the order-confirmation email right after checkout.
# Status-update emails now live in the separate admin app.
RESEND_API_KEY=
ORDERS_FROM_EMAIL=orders@skinwiseshop.in
